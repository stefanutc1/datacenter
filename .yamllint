extends: default

ignore: |
  node_modules/
  **/node_modules/
  .venv/
  **/.venv/
  dist/
  **/dist/
  build/
  **/build/
  .git/
  **/.git/

rules:
  line-length: disable
  document-start: disable
  truthy: disable
  brackets: disable
  braces: disable
  trailing-spaces: disable
  empty-lines: disable
  indentation: disable
  comments: disable
  colons: disable
