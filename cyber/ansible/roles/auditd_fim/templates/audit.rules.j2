# Managed by Ansible - CyberLab CIS-Aligned Auditd Rules

# Delete all existing rules
-D

# Buffer size to handle high throughput
-b 8192

# Failure mode (1 = printk/syslog, 2 = kernel panic on critical failure)
-f 1

# Rate limit (messages per second)
-r 500

# 1. Identity & Credential Monitoring
-w /etc/passwd -p wa -k identity_changes
-w /etc/gshadow -p wa -k identity_changes
-w /etc/shadow -p wa -k identity_changes
-w /etc/security/opasswd -p wa -k identity_changes
-w /etc/sudoers -p wa -k sudo_changes
-w /etc/sudoers.d/ -p wa -k sudo_changes

# 2. Network & Host Configuration Modifications
-w /etc/issue -p wa -k system_banner_changes
-w /etc/issue.net -p wa -k system_banner_changes
-w /etc/hosts -p wa -k network_changes
-w /etc/network/ -p wa -k network_changes
-w /etc/netplan/ -p wa -k network_changes

# 3. System Call & Kernel Module Operations
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k kernel_modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k kernel_modules

# 4. Privilege Escalation & Execution
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k priv_escalation
-a always,exit -F arch=b32 -S execve -C uid!=euid -F euid=0 -k priv_escalation

# 5. File Integrity Monitoring (FIM) for Critical System Binaries
-w /bin/ -p wa -k bin_modification
-w /sbin/ -p wa -k sbin_modification
-w /usr/bin/ -p wa -k usr_bin_modification
-w /usr/sbin/ -p wa -k usr_sbin_modification

# 6. Make Configuration Immutable until Reboot
-e 2
