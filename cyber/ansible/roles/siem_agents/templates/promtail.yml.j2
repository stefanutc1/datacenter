server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/log/promtail-positions.yaml

clients:
  - url: {{ loki_server_url }}/loki/api/v1/push

scrape_configs:
  - job_name: system_auth
    static_configs:
      - targets:
          - localhost
        labels:
          job: system_auth
          host: {{ inventory_hostname }}
          __path__: /var/log/auth.log

  - job_name: auditd_logs
    static_configs:
      - targets:
          - localhost
        labels:
          job: auditd
          host: {{ inventory_hostname }}
          __path__: /var/log/audit/audit.log

  - job_name: syslog
    static_configs:
      - targets:
          - localhost
        labels:
          job: syslog
          host: {{ inventory_hostname }}
          __path__: /var/log/syslog
