# Managed by Ansible - CyberLab Fail2ban Configuration
[DEFAULT]
bantime = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
backend = systemd
banaction = ufw

[sshd]
enabled = true
port = {{ ssh_port }}
filter = sshd
maxretry = {{ fail2ban_maxretry }}
bantime = {{ fail2ban_bantime }}
