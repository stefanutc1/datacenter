# ==========================================
# ELO ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Application Settings
ELO_ENV=development
ELO_HOST=0.0.0.0
ELO_PORT=8000
ELO_SECRET_KEY=change_this_to_a_random_32_char_secret_key_minimum

# Telegram Bot Interface
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Database & Cache
DATABASE_URL=postgresql://elo_admin:elo_secure_pass_change_me@localhost:5432/elo_brain
REDIS_URL=redis://localhost:6379/0

# LLM Providers Configuration (Tiered Cascade Failover)
PRIMARY_LLM_PROVIDER=cloud_gemini
FALLBACK_LLM_PROVIDER=mock

# Google Gemini Cloud (Direct)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter.ai (Universal Multi-Model Hub: GPT-4o, Claude 3.5, DeepSeek R1, Llama 3.3)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI Direct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude Direct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local LLM (Ollama / vLLM on Proxmox or Apple M1)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b

# Homelab Dynamic Probe Node IPs
PROXMOX_NODE_IP=192.168.10.2
NAS_NODE_IP=192.168.10.3
M1_NODE_IP=192.168.20.4

# Security & Approval Gatekeeper
DEFAULT_APPROVAL_TIMEOUT_SECONDS=300
ENABLE_STRICT_L3_CHALLENGE=true
