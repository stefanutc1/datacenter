# ==============================================================================
# Caddy Mutual TLS (mTLS) Inter-Service Gateway (VLAN 20 Security Core)
# Enforces mandatory client-certificate validation before proxying traffic.
# ==============================================================================
{
    admin off
    auto_https off
}

# Critical Vault Backend with strict mTLS
https://vault.internal:8200 {
    tls /etc/ssl/certs/server.crt /etc/ssl/certs/server.key {
        client_auth {
            mode require_and_verify
            trusted_ca_cert_file /etc/ssl/certs/internal_root_ca.crt
        }
    }
    reverse_proxy 192.168.1.132:8200
}

# Critical Database / Storage Backend with mTLS
https://db-secure.internal:5432 {
    tls /etc/ssl/certs/server.crt /etc/ssl/certs/server.key {
        client_auth {
            mode require_and_verify
            trusted_ca_cert_file /etc/ssl/certs/internal_root_ca.crt
        }
    }
    reverse_proxy 192.168.1.41:5432
}
